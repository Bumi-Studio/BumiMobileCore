<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Required permissions for gallery access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    
    <!-- Required for image uploads over network -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Optional: for accessing files -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    
    <!-- Application configuration -->
    <application>
        <!-- Custom Activity to handle gallery callbacks -->
        <activity 
            android:name="com.bumimobile.gallery.GalleryActivity"
            android:exported="false" />
    </application>
    
</manifest>
